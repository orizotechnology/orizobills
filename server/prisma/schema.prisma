// =============================================================
// ORIZO BILLS — Prisma Schema (MySQL 8.0)
// =============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// =============================================================
// BRANCH REGISTRY
// =============================================================

model Branch {
  id        String   @id @default(uuid()) @db.VarChar(36)
  name      String   @db.VarChar(255)
  slug      String   @unique @db.VarChar(100)
  address   String?  @db.Text
  isActive  Boolean  @default(true)
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("branches")
}

// =============================================================
// PRODUCT CATALOGUE
// =============================================================

model Product {
  id             String   @id @default(uuid()) @db.VarChar(36)
  name           String   @db.VarChar(500)
  code           String   @unique @db.VarChar(100)
  barcode        String?  @unique @db.VarChar(100)
  description    String?  @db.Text
  hsn            String?  @db.VarChar(20)
  mrp            Decimal  @default(0) @db.Decimal(10, 2)
  discPctOnMrp   Decimal  @default(0) @db.Decimal(5, 2)
  salePrice      Decimal  @default(0) @db.Decimal(10, 2)
  purchasePrice  Decimal  @default(0) @db.Decimal(10, 2)
  discountType   String   @default("Discount %") @db.VarChar(50)
  saleDiscount   Decimal  @default(0) @db.Decimal(10, 2)
  taxPct         Decimal  @default(0) @db.Decimal(5, 2)
  taxRate        String?  @db.VarChar(50)
  taxInclusive   Boolean  @default(false)
  unit           String   @default("Nos") @db.VarChar(50)
  secondaryUnit  String?  @db.VarChar(50)
  conversionRate Decimal? @db.Decimal(10, 4)
  location       String?  @db.VarChar(255)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  inventoryItem InventoryItem?
  batches       ProductBatch[]
  purchaseItems PurchaseInvoiceItem[]
  saleItems     SaleInvoiceItem[]
  saleOrderItems SaleOrderItem[]
  challanItems  DeliveryChallanItem[]
  saleReturnItems SaleReturnItem[]

  @@index([isActive])
  @@index([name])
  @@map("products")
}

// =============================================================
// PRODUCT BATCHES
// =============================================================

model ProductBatch {
  id           String   @id @default(uuid()) @db.VarChar(36)
  productId    String   @db.VarChar(36)
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  batchName    String   @db.VarChar(100)
  openingStock Decimal  @default(0) @db.Decimal(12, 3)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([productId, batchName])
  @@map("product_batches")
}

// =============================================================
// INVENTORY
// =============================================================

model InventoryItem {
  id            String   @id @default(uuid()) @db.VarChar(36)
  productId     String   @unique @db.VarChar(36)
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  openingStock  Decimal  @default(0) @db.Decimal(12, 3)
  stockIn       Decimal  @default(0) @db.Decimal(12, 3)
  stockOut      Decimal  @default(0) @db.Decimal(12, 3)
  lowStockAlert Decimal  @default(5) @db.Decimal(12, 3)
  updatedAt     DateTime @updatedAt

  @@map("inventory_items")
}

// =============================================================
// CUSTOMERS
// =============================================================

model Customer {
  id        String   @id @default(uuid()) @db.VarChar(36)
  name      String   @db.VarChar(500)
  phone     String?  @unique @db.VarChar(20)
  email     String?  @db.VarChar(255)
  address   String?  @db.Text
  gstin     String?  @db.VarChar(20)
  balance   Decimal  @default(0) @db.Decimal(12, 2)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  saleInvoices SaleInvoice[]
  paymentsIn   PaymentIn[]
  saleOrders   SaleOrder[]
  challans     DeliveryChallan[]
  saleReturns  SaleReturn[]

  @@index([isActive])
  @@map("customers")
}

// =============================================================
// SUPPLIERS
// =============================================================

model Supplier {
  id        String   @id @default(uuid()) @db.VarChar(36)
  name      String   @db.VarChar(500)
  phone     String?  @unique @db.VarChar(20)
  email     String?  @db.VarChar(255)
  address   String?  @db.Text
  gstin     String?  @db.VarChar(20)
  balance   Decimal  @default(0) @db.Decimal(12, 2)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchases       PurchaseInvoice[]
  purchaseReturns PurchaseReturn[]

  @@index([isActive])
  @@map("suppliers")
}

// =============================================================
// PURCHASE INVOICES
// =============================================================

model PurchaseInvoice {
  id            String    @id @default(uuid()) @db.VarChar(36)
  invoiceNumber String    @unique @db.VarChar(50)
  supplierId    String?   @db.VarChar(36)
  supplier      Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  supplierName  String    @db.VarChar(500)
  billDate      DateTime  @default(now())
  poNumber      String?   @db.VarChar(100)
  poDate        DateTime?
  paymentMethod String    @default("Cash") @db.VarChar(50)
  subtotal      Decimal   @default(0) @db.Decimal(12, 2)
  discountPct   Decimal   @default(0) @db.Decimal(5, 2)
  discountAmt   Decimal   @default(0) @db.Decimal(12, 2)
  taxAmt        Decimal   @default(0) @db.Decimal(12, 2)
  totalAmt      Decimal   @default(0) @db.Decimal(12, 2)
  taxType       String    @default("NONE") @db.VarChar(20)
  terms         String?   @db.Text
  notes         String?   @db.Text
  status        String    @default("CONFIRMED") @db.VarChar(20)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  items   PurchaseInvoiceItem[]
  returns PurchaseReturn[]

  @@index([billDate])
  @@index([status])
  @@index([supplierId])
  @@map("purchase_invoices")
}

model PurchaseInvoiceItem {
  id          String          @id @default(uuid()) @db.VarChar(36)
  invoiceId   String          @db.VarChar(36)
  invoice     PurchaseInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId   String?         @db.VarChar(36)
  product     Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  itemName    String          @db.VarChar(500)
  itemCode    String          @db.VarChar(100)
  quantity    Decimal         @db.Decimal(12, 3)
  unit        String          @default("Nos") @db.VarChar(50)
  mrp         Decimal         @default(0) @db.Decimal(10, 2)
  unitPrice   Decimal         @default(0) @db.Decimal(10, 2)
  discountPct Decimal         @default(0) @db.Decimal(5, 2)
  discountAmt Decimal         @default(0) @db.Decimal(12, 2)
  taxPercent  Decimal         @default(0) @db.Decimal(5, 2)
  taxAmount   Decimal         @default(0) @db.Decimal(12, 2)
  totalAmount Decimal         @default(0) @db.Decimal(12, 2)

  @@map("purchase_invoice_items")
}

// =============================================================
// PURCHASE RETURNS
// =============================================================

model PurchaseReturn {
  id           String          @id @default(uuid()) @db.VarChar(36)
  returnNumber String          @unique @db.VarChar(50)
  invoiceId    String?         @db.VarChar(36)
  invoice      PurchaseInvoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  supplierId   String?         @db.VarChar(36)
  supplier     Supplier?       @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  supplierName String          @db.VarChar(500)
  returnDate   DateTime        @default(now())
  reason       String?         @db.Text
  subtotal     Decimal         @default(0) @db.Decimal(12, 2)
  totalAmt     Decimal         @default(0) @db.Decimal(12, 2)
  status       String          @default("CONFIRMED") @db.VarChar(20)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@map("purchase_returns")
}

// =============================================================
// SALE INVOICES
// =============================================================

model SaleInvoice {
  id            String    @id @default(uuid()) @db.VarChar(36)
  invoiceNumber String    @unique @db.VarChar(50)
  customerId    String?   @db.VarChar(36)
  customer      Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName  String    @default("Walk-in Customer") @db.VarChar(500)
  invoiceDate   DateTime  @default(now())
  paymentMethod String    @default("Cash") @db.VarChar(50)
  subtotal      Decimal   @default(0) @db.Decimal(12, 2)
  discountPct   Decimal   @default(0) @db.Decimal(5, 2)
  discountAmt   Decimal   @default(0) @db.Decimal(12, 2)
  cgst          Decimal   @default(0) @db.Decimal(12, 2)
  sgst          Decimal   @default(0) @db.Decimal(12, 2)
  totalAmt      Decimal   @default(0) @db.Decimal(12, 2)
  paidAmt       Decimal   @default(0) @db.Decimal(12, 2)
  balanceDue    Decimal   @default(0) @db.Decimal(12, 2)
  notes         String?   @db.Text
  status        String    @default("PAID") @db.VarChar(20)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  items    SaleInvoiceItem[]
  payments PaymentIn[]
  returns  SaleReturn[]

  @@index([invoiceDate])
  @@index([status])
  @@index([customerId])
  @@map("sale_invoices")
}

model SaleInvoiceItem {
  id          String      @id @default(uuid()) @db.VarChar(36)
  invoiceId   String      @db.VarChar(36)
  invoice     SaleInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId   String?     @db.VarChar(36)
  product     Product?    @relation(fields: [productId], references: [id], onDelete: SetNull)
  itemName    String      @db.VarChar(500)
  itemCode    String      @db.VarChar(100)
  quantity    Decimal     @db.Decimal(12, 3)
  unit        String      @default("Nos") @db.VarChar(50)
  mrp         Decimal     @default(0) @db.Decimal(10, 2)
  unitPrice   Decimal     @default(0) @db.Decimal(10, 2)
  discountPct Decimal     @default(0) @db.Decimal(5, 2)
  discountAmt Decimal     @default(0) @db.Decimal(12, 2)
  taxPercent  Decimal     @default(0) @db.Decimal(5, 2)
  taxAmount   Decimal     @default(0) @db.Decimal(12, 2)
  totalAmount Decimal     @default(0) @db.Decimal(12, 2)

  @@map("sale_invoice_items")
}

// =============================================================
// PAYMENTS IN
// =============================================================

model PaymentIn {
  id            String      @id @default(uuid()) @db.VarChar(36)
  paymentNumber String      @unique @db.VarChar(50)
  customerId    String?     @db.VarChar(36)
  customer      Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName  String      @default("Walk-in Customer") @db.VarChar(500)
  invoiceId     String?     @db.VarChar(36)
  invoice       SaleInvoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  amount        Decimal     @db.Decimal(12, 2)
  paymentMethod String      @default("Cash") @db.VarChar(50)
  paymentDate   DateTime    @default(now())
  reference     String?     @db.VarChar(255)
  notes         String?     @db.Text
  createdAt     DateTime    @default(now())

  @@map("payments_in")
}

// =============================================================
// SALE ORDERS
// =============================================================

model SaleOrder {
  id           String    @id @default(uuid()) @db.VarChar(36)
  orderNumber  String    @unique @db.VarChar(50)
  customerId   String?   @db.VarChar(36)
  customer     Customer? @relation(fields: [customerId], references: [id])
  customerName String    @default("Walk-in Customer") @db.VarChar(500)
  orderDate    DateTime  @default(now())
  dueDate      DateTime?
  subtotal     Decimal   @default(0) @db.Decimal(12, 2)
  totalAmt     Decimal   @default(0) @db.Decimal(12, 2)
  notes        String?   @db.Text
  status       String    @default("PENDING") @db.VarChar(20)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  items SaleOrderItem[]

  @@map("sale_orders")
}

model SaleOrderItem {
  id          String    @id @default(uuid()) @db.VarChar(36)
  orderId     String    @db.VarChar(36)
  order       SaleOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String?   @db.VarChar(36)
  product     Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  itemName    String    @db.VarChar(500)
  itemCode    String    @db.VarChar(100)
  quantity    Decimal   @db.Decimal(12, 3)
  unitPrice   Decimal   @default(0) @db.Decimal(10, 2)
  totalAmount Decimal   @default(0) @db.Decimal(12, 2)

  @@map("sale_order_items")
}

// =============================================================
// DELIVERY CHALLANS
// =============================================================

model DeliveryChallan {
  id            String    @id @default(uuid()) @db.VarChar(36)
  challanNumber String    @unique @db.VarChar(50)
  customerId    String?   @db.VarChar(36)
  customer      Customer? @relation(fields: [customerId], references: [id])
  customerName  String    @default("Walk-in Customer") @db.VarChar(500)
  challanDate   DateTime  @default(now())
  vehicleNo     String?   @db.VarChar(50)
  notes         String?   @db.Text
  status        String    @default("PENDING") @db.VarChar(20)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  items DeliveryChallanItem[]

  @@map("delivery_challans")
}

model DeliveryChallanItem {
  id          String          @id @default(uuid()) @db.VarChar(36)
  challanId   String          @db.VarChar(36)
  challan     DeliveryChallan @relation(fields: [challanId], references: [id], onDelete: Cascade)
  productId   String?         @db.VarChar(36)
  product     Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  itemName    String          @db.VarChar(500)
  itemCode    String          @db.VarChar(100)
  quantity    Decimal         @db.Decimal(12, 3)
  unit        String          @default("Nos") @db.VarChar(50)

  @@map("delivery_challan_items")
}

// =============================================================
// SALE RETURNS
// =============================================================

model SaleReturn {
  id           String      @id @default(uuid()) @db.VarChar(36)
  returnNumber String      @unique @db.VarChar(50)
  invoiceId    String?     @db.VarChar(36)
  invoice      SaleInvoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  customerId   String?     @db.VarChar(36)
  customer     Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName String      @default("Walk-in Customer") @db.VarChar(500)
  returnDate   DateTime    @default(now())
  reason       String?     @db.Text
  subtotal     Decimal     @default(0) @db.Decimal(12, 2)
  totalAmt     Decimal     @default(0) @db.Decimal(12, 2)
  status       String      @default("CONFIRMED") @db.VarChar(20)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  items SaleReturnItem[]

  @@map("sale_returns")
}

model SaleReturnItem {
  id          String     @id @default(uuid()) @db.VarChar(36)
  returnId    String     @db.VarChar(36)
  return      SaleReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  productId   String?    @db.VarChar(36)
  product     Product?   @relation(fields: [productId], references: [id], onDelete: SetNull)
  itemName    String     @db.VarChar(500)
  itemCode    String     @db.VarChar(100)
  quantity    Decimal    @db.Decimal(12, 3)
  unitPrice   Decimal    @default(0) @db.Decimal(10, 2)
  totalAmount Decimal    @default(0) @db.Decimal(12, 2)

  @@map("sale_return_items")
}

// =============================================================
// EXPENSES
// =============================================================

model Expense {
  id            String   @id @default(uuid()) @db.VarChar(36)
  expenseNumber String   @unique @db.VarChar(50)
  category      String   @default("General") @db.VarChar(100)
  description   String?  @db.Text
  amount        Decimal  @db.Decimal(12, 2)
  paymentMethod String   @default("Cash") @db.VarChar(50)
  expenseDate   DateTime @default(now())
  reference     String?  @db.VarChar(255)
  notes         String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([expenseDate])
  @@index([category])
  @@map("expenses")
}

# =============================================================
# ORIZO BILLS — BACKEND ENV TEMPLATE
# Copy this file to .env and fill in your values.
# =============================================================

# Server
NODE_ENV=development
PORT=5000
HOST=0.0.0.0

# Database — MySQL 8.0
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:your_password@localhost:3306/erp_system"

# JWT (change both secrets to long random strings in production)
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=change-this-refresh-secret-too
JWT_REFRESH_EXPIRES_IN=30d

# CORS — Tauri WebView origins
CORS_ORIGIN=tauri://localhost,https://tauri.localhost,http://localhost:3000

# Logging
LOG_LEVEL=info

# MySQL binary path (Windows — used by db-init for schema push)
MYSQL_BIN=C:\Program Files\MySQL\MySQL Server 8.0\bin

# =============================================================
# ORIZO BILLS — BACKEND ENV TEMPLATE
#
# HOW TO SET UP (each developer does this once):
#   1. Copy this file:  copy .env.example .env
#   2. Open .env
#   3. Replace YOUR_MYSQL_PASSWORD_HERE with your MySQL root password
#   4. Run the server — DB will be created automatically
#
# ONLY the password needs to change. Leave everything else as-is
# unless you have a non-standard MySQL setup (different port/user).
# =============================================================

# Server
NODE_ENV=development
PORT=5000
HOST=0.0.0.0

# ─────────────────────────────────────────────────────────────
# DATABASE — MySQL 8.0
#
# ✏️  EDIT THIS LINE: replace YOUR_MYSQL_PASSWORD_HERE with your
#    actual MySQL root password. Everything else stays the same.
#
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# ─────────────────────────────────────────────────────────────
DATABASE_URL="mysql://root:pavan@localhost:3306/erp_system"

# JWT — leave these as-is for development
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=change-this-refresh-secret-too
JWT_REFRESH_EXPIRES_IN=30d

# CORS — Tauri WebView origins (no changes needed)
CORS_ORIGIN=tauri://localhost,https://tauri.localhost,http://localhost:3000

# Logging
LOG_LEVEL=info

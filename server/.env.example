# =============================================================
# ORIZO BILLS — BACKEND ENV TEMPLATE
#
# HOW TO SET UP (one-time, per machine):
#   1. Copy this file:   copy server\.env.example server\.env
#   2. Open server\.env
#   3. Replace YOUR_PASSWORD with your MySQL root password
#   4. Save and run the server — DB is created automatically
#
# Only the password line needs to change.
# Everything else works as-is for a standard MySQL 8.0 install.
# =============================================================

# ── Server ────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
HOST=0.0.0.0

# ── Database (MySQL 8.0) ──────────────────────────────────────
#
#  ✏️  CHANGE THIS: replace YOUR_PASSWORD with your MySQL root password.
#
#  Format:  mysql://USER:PASSWORD@HOST:PORT/DATABASE
#  Example: mysql://root:MyPass123@localhost:3306/erp_system
#
#  The database (erp_system) is created automatically on first run.
#  Leave the database name as "erp_system" unless you have a reason to change it.
#
DATABASE_URL="mysql://root:YOUR_PASSWORD@localhost:3306/erp_system"

# ── JWT (leave as-is for development) ────────────────────────
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=change-this-refresh-secret-too
JWT_REFRESH_EXPIRES_IN=30d

# ── CORS (no changes needed for Tauri) ───────────────────────
CORS_ORIGIN=tauri://localhost,https://tauri.localhost,http://localhost:3000

# ── Logging ───────────────────────────────────────────────────
LOG_LEVEL=info
